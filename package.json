{
	"name": "@treeviz/xlsx-to-ged",
	"version": "1.0.0",
	"description": "Excel .xlsx to GEDCOM .ged converter with configurable column mapping (TypeScript)",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"xlsx-to-ged": "dist/cli-xlsx-to-ged.js"
	},
	"files": [
		"dist",
		"examples",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"dev:xlsx": "tsx src/cli-xlsx-to-ged.ts",
		"generate:example": "tsx scripts/generate-example-xlsx.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:idavidka/xlsx-to-gedcom.git"
	},
	"author": "idavidka & @treeviz contributors",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"keywords": [
		"xlsx",
		"excel",
		"gedcom",
		"ged",
		"converter",
		"genealogy",
		"family-tree",
		"typescript"
	],
	"dependencies": {
		"exceljs": "^4.4.0",
		"yargs": "^17.7.2"
	},
	"devDependencies": {
		"@types/node": "^24.6.0",
		"@types/yargs": "^17.0.33",
		"tsup": "^8.5.1",
		"tsx": "^4.19.0",
		"typescript": "^5.6.3",
		"vitest": "^3.0.7"
	}
}
